# Copy to .env and customise. Consumed by `docker compose`.

# Logging level: error, warn, info, debug, trace
RUST_LOG=info

# Host port the service is published on (container always listens on 8080)
EXTERNAL_PORT=8080

# Characters per PIN, 5 bits each. A PIN is a bearer token and the only access
# control this service has, so 10 (50 bits) is the floor for anything public.
PIN_LENGTH=10

# Minutes of inactivity before a PIN is evicted. Polling or submitting resets it.
STALE_AGE_MINS=10

# Maximum request body accepted by PUT, in bytes on the wire.
MAX_PAYLOAD_BYTES=3000

# Hard cap on live PINs. Allocation returns 503 past this point.
MAX_ENTRIES=100000

# Comma-separated CORS origin allowlist. Empty means any origin.
CORS_ALLOWED_ORIGINS=

# Host interface the port binds to. Default publishes on all of them; set to
# 127.0.0.1 to reach the service only from this host.
PUBLISH_ADDRESS=0.0.0.0

# Live PINs one namespace may hold, so a single tenant cannot fill the service.
MAX_PINS_PER_NAMESPACE=1000

# Wrong-PIN guesses allowed per namespace per window before returning 429.
# Only unknown PINs count, so a caller holding a real PIN is never throttled.
MAX_PROBE_MISSES=60
# ...and across all namespaces, since namespaces are free to invent.
MAX_GLOBAL_MISSES=600
PROBE_WINDOW_SECS=60

# Ceiling on `?wait=` long polling, in seconds.
MAX_LONG_POLL_SECS=30
