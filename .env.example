# Copy to .env and customise. Consumed by `docker compose`.

# Logging level: error, warn, info, debug, trace
RUST_LOG=info

# Host port the service is published on (container always listens on 8080)
EXTERNAL_PORT=8080

# Characters per PIN. 4 is short enough to read aloud; raise it if the PINs
# guard anything worth brute-forcing (each character adds 5 bits).
PIN_LENGTH=4

# Minutes of inactivity before a PIN is evicted. Polling or submitting resets it.
STALE_AGE_MINS=10

# Maximum request body accepted by PUT, in bytes on the wire.
MAX_PAYLOAD_BYTES=3000

# Hard cap on live PINs. Allocation returns 503 past this point.
MAX_ENTRIES=100000

# Comma-separated CORS origin allowlist. Empty means any origin.
CORS_ALLOWED_ORIGINS=
